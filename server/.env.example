PORT=4000
DATABASE_URL=postgres://...            # Neon connection string
JWT_SECRET=change-me

# Website origin(s) allowed to call the API in production (comma-separated).
# Any localhost port is always allowed for development.
CLIENT_URL=https://www.your-domain.com

# AI chat assistant (answers visitors when you are not available in the admin chat).
# Without a key the chat still works; visitors just get a polite "we'll reply soon" message.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5        # optional; e.g. claude-haiku-4-5 for a cheaper/faster assistant

# Online payments (Stripe Checkout). Without a key, the Pay button is hidden and
# you can record payments by hand in the admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                 # optional locally; needed in production (endpoint: /api/stripe/webhook)

# MonCash (Digicel Haiti). Get client id/secret from the MonCash business portal
# (https://moncashbutton.digicelgroup.com). Use sandbox until you go live.
# In the portal, set the RETURN URL to: https://YOUR-SITE/shipping/moncash/return
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_MODE=sandbox                   # sandbox | live
# MONCASH_USD_TO_HTG=131               # optional default; you can set the rate in Admin → Shipping

# PayPal (Orders API). Create a REST app at https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                    # sandbox | live
